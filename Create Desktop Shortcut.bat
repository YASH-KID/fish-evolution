@echo off
setlocal
set "APPROOT=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = $env:APPROOT.TrimEnd('\'); $indexPath = Join-Path $root 'index.html'; $iconPath = Join-Path $root 'icon.ico'; $chromeCandidates = @('C:\Program Files\Google\Chrome\Application\chrome.exe','C:\Program Files (x86)\Google\Chrome\Application\chrome.exe',(Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe')); $edgeCandidates = @('C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe','C:\Program Files\Microsoft\Edge\Application\msedge.exe',(Join-Path $env:LOCALAPPDATA 'Microsoft\Edge\Application\msedge.exe')); $browser = ($chromeCandidates + $edgeCandidates) | Where-Object { Test-Path $_ } | Select-Object -First 1; if (-not $browser) { Write-Host 'Could not find Chrome or Edge installed on this computer.'; Write-Host 'Please install Google Chrome or Microsoft Edge, then run this again.'; exit 1 }; $fileUrl = ([System.Uri]$indexPath).AbsoluteUri; $desktop = [Environment]::GetFolderPath('Desktop'); $lnkPath = Join-Path $desktop 'Fish Evolution.lnk'; $shell = New-Object -ComObject WScript.Shell; $lnk = $shell.CreateShortcut($lnkPath); $lnk.TargetPath = $browser; $lnk.Arguments = '--app=' + $fileUrl; $lnk.IconLocation = $iconPath + ',0'; $lnk.WorkingDirectory = $root; $lnk.Save(); Write-Host ('Shortcut created on your Desktop as "Fish Evolution", using ' + $browser)"
echo.
pause
